<Window
    x:Class="AbioticFactorModManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar"
              Grid.Row="0"
              Background="#181818"
              Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="TitleBarDragRegion"
                  Grid.Column="0"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <TextBlock x:Name="AppTitleText"
                           Text="Abiotic Factor Mod Manager"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"/>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Stretch">
                <Button x:Name="LaunchGameButton"
                        Content="Launch Game"
                        Width="108" Height="34"
                        Margin="6,7"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Launch Abiotic Factor with the current launch options"/>                <Button x:Name="MinimizeWindowButton"
                        Width="46" Height="48"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Minimize">
                    <FontIcon Glyph="&#xE921;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="12"/>
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Width="46" Height="48"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Maximize">
                    <FontIcon x:Name="MaximizeWindowGlyph"
                              Glyph="&#xE922;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="12"/>
                </Button>
                <Button x:Name="CloseWindowButton"
                        Width="46" Height="48"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE8BB;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="220"
                        CompactPaneLength="56"
                        SelectionFollowsFocus="Enabled"
                        IsTabStop="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="PaneToggleNavigationItem"
                                    Content="&#x00A0;"
                                    Tag="PaneToggle"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE700;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="16"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Browse Mods" Tag="Browse" SelectsOnInvoked="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed Mods" Tag="Installed" SelectsOnInvoked="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="PageContentHost"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Frame x:Name="ContentFrame"
                       IsNavigationStackEnabled="False"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch"
                       VerticalContentAlignment="Stretch"/>
                <Grid x:Name="GameFolderOverlay"
                      Visibility="Collapsed"
                      IsHitTestVisible="True">
                    <Border x:Name="GameFolderBlurLayer"/>
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520"
                            Padding="28"
                            CornerRadius="12"
                            Background="#DD202020"
                            BorderBrush="#665F5F5F"
                            BorderThickness="1">
                        <StackPanel Spacing="14"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Set your game folder first"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="A valid Abiotic Factor game folder is required before you can browse or manage mods. If you have installed it through Steam, restart the app to attempt automatic detection. Otherwise, open Settings and select the game executable."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       MaxWidth="440"
                                       Opacity="0.86"/>
                            <Button x:Name="OpenGameFolderSettingsButton"
                                    Content="Open Settings"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>